{
  "name": "pf-kektura-frontend",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "prestart": "cd src && node get-version.js && cd ..",
    "build": "ng build kektura_frontend_app --configuration production",
    "start": "ng serve",
    "watch": "ng build --watch",
    "test": "ng test",
    "lint": "tsc --noEmit && eslint . --ext .js,.ts --quiet --fix",
    "generate:api:local": "openapi-generator-cli generate -g typescript-angular -i http://localhost:8080/api/v3/api-docs -o ./src/app/shared/client",
    "generate:api:test": "export JAVA_OPTS='-Dio.swagger.parser.util.RemoteUrl.trustAll=true -Dio.swagger.v3.parser.util.RemoteUrl.trustAll=true' && openapi-generator-cli generate -g typescript-angular -i https://.../api/v3/api-docs -o ./src/app/shared/client",
    "generate:api:demo": "export JAVA_OPTS='-Dio.swagger.parser.util.RemoteUrl.trustAll=true -Dio.swagger.v3.parser.util.RemoteUrl.trustAll=true' && openapi-generator-cli generate -g typescript-angular -i https://.../api/v3/api-docs -o ./src/app/shared/client",
    "generate:api:prod": "export JAVA_OPTS='-Dio.swagger.parser.util.RemoteUrl.trustAll=true -Dio.swagger.v3.parser.util.RemoteUrl.trustAll=true' && openapi-generator-cli generate -g typescript-angular -i https://.../api/v3/api-docs -o ./src/app/shared/client",
    "generate:api:ndev": "export JAVA_OPTS='-Dio.swagger.parser.util.RemoteUrl.trustAll=true -Dio.swagger.v3.parser.util.RemoteUrl.trustAll=true' && openapi-generator-cli generate -g typescript-angular -i https://.../api/v3/api-docs -o ./src/app/shared/client"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "*.{html,css,less,ejs}": [
      "prettier --write",
      "git add"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@auth0/angular-jwt": "^5.0.2",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@ng-select/ng-select": "10.0.4",
    "@ngneat/until-destroy": "^10.0.0",
    "@openapitools/openapi-generator-cli": "^2.6.0",
    "@sentry/angular": "^7.12.1",
    "@sentry/tracing": "^7.12.1",
    "@swimlane/ngx-datatable": "20.1.0",
    "@turf/turf": "5.1.6",
    "amcharts3": "3.21.15",
    "bootstrap": "^5.1.0",
    "cesium": "1.101.0",
    "changedpi": "1.0.4",
    "deepdash": "^5.3.9",
    "dom-autoscroller": "^2.3.4",
    "exifreader": "^4.23.3",
    "jquery": "^3.6.4",
    "jquery-ui-dist": "^1.13.2",
    "lodash-es": "^4.17.21",
    "ng2-dragula": "^2.1.1",
    "ng2-file-upload": "1.4.0",
    "ngx-autosize": "^1.8.7",
    "ngx-bootstrap": "^10.0.0",
    "ngx-cookie-service": "^15.0.0",
    "ngx-google-analytics": "^14.0.1",
    "ol": "^6.6.1",
    "placeholder-loading": "^0.6.0",
    "rfs": "^9.0.6",
    "rxjs": "~6.6.0",
    "rxjs-compat": "6.6.7",
    "sass": "^1.38.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular-eslint/builder": "15.2",
    "@angular-eslint/eslint-plugin": "15.2",
    "@angular-eslint/eslint-plugin-template": "15.2",
    "@angular-eslint/schematics": "15.2",
    "@angular-eslint/template-parser": "15.2",
    "@angular/cli": "^15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@kolkov/angular-editor": "^3.0.0-beta.0",
    "@ngrx/store": "^15.2",
    "@types/jasmine": "~3.8.0",
    "@types/jquery": "^3.5.23",
    "@types/lodash-es": "^4.17.5",
    "@types/node": "^12.11.1",
    "@typescript-eslint/eslint-plugin": "5.3.0",
    "@typescript-eslint/parser": "5.3.0",
    "eslint": "^8.2.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-angular": "^4.0.1",
    "eslint-plugin-prettier": "^3.4.1",
    "husky": "^8.0.3",
    "jasmine-core": "~3.8.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "lint-staged": "^11.1.2",
    "prettier": "^2.3.2",
    "prettier-eslint": "^13.0.0",
    "typescript": "~4.8"
  }
}
